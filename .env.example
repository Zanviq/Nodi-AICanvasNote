# 복사해서 .env로 쓴다. .env는 커밋하지 않는다.

# Gemini API 키. 비워 두면 앱 설정 화면에서 넣은 키(브라우저 저장)를 쓴다.
GEMINI_API_KEY=

# 손글씨 인식 모델과 답 모델
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_ANSWER_MODEL=gemini-3.8-flash

# 생각 수준: minimal / low / medium / high. 비우면 보내지 않는다.
GEMINI_THINKING_LEVEL=low

# SQLite 파일 위치 (Docker에서는 볼륨 /data 안)
DATABASE_PATH=/data/note.db

# 쉼표로 구분한 허용 출처. Docker에서는 nginx가 같은 출처로 프록시하므로 개발 서버만 넣는다.
CORS_ORIGINS=http://localhost:5173

# 공개 인터넷에 띄울 때는 반드시 정한다. 정하면 앱 설정의 「접근 코드」에 같은 값을 넣어야 API를 쓸 수 있다.
# 비워 두면 접근 제한이 없다 (내 컴퓨터에서만 쓸 때).
APP_ACCESS_TOKEN=
